# Node / Vite
node_modules
dist
dist-ssr
*.local
.vite

# Python
**/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Tauri
src-tauri/target
src-tauri/gen

# Editor
.idea
.vscode
*.swp

# OS
.DS_Store
Thumbs.db

# Local data
.env
.env.local
*.log

# Build artifacts — electron-builder's output (build/ holds the icons and the launcher:
# tracked, as JustWrite's)
release/
dist-electron/

# Engine model weights — downloaded at runtime from HuggingFace; not source
server/justvoice/engines/*/models/
server/justvoice/engines/*/.venv/
server/justvoice/engines/*/voices/
server/justvoice/engines/*/state/
server/justvoice/engines/.shared-venv/
# The audio.cpp speech runtime + eSpeak NG, installed by the app. In a source checkout the
# runtime root IS the engines dir, so they land beside the package's own .py files —
# everything in that folder but its source is install output (2 GB for the CUDA build).
server/justvoice/engines/audiocpp/*
!server/justvoice/engines/audiocpp/*.py

# Test-render artifacts (audio output of smoke tests)
scripts/*.wav
scripts/_shots/

# SQLite DBs created at runtime
*.db
*.sqlite
*.sqlite3
*-journal
*-wal
*-shm

# Server data dir (settings, audio, etc.) — the dev data folder, and the empty headless root
# renamed aside when it moved here (2026-10-08)
data/
data-old-*/
server/data/
target/
.claude/worktrees/
