{
  "name": "justvoice",
  "version": "0.1.0",
  "description": "An open-source TTS server built for audiobook production, useful for any TTS workload.",
  "productName": "JustVoice",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "quasar dev -m electron",
    "dev:spa": "quasar dev",
    "build": "quasar build -m electron",
    "build:spa": "quasar build",
    "build:unpacked": "quasar build -m electron --skip-pkg",
    "postinstall": "quasar prepare --silent",
    "server": "node scripts/node24.js server/src/serve.js serve",
    "test:server": "node scripts/node24.js node_modules/vitest/vitest.mjs run --config server/vitest.config.js",
    "test:unit": "vitest run",
    "lint": "biome check .",
    "smoke": "node scripts/smoke.js",
    "screenshots": "node scripts/smoke_gui.js",
    "test": "node scripts/e2e.js",
    "eval:discover": "node scripts/node24.js server/scripts/eval_discover.js",
    "eval:attribution": "node scripts/node24.js server/scripts/eval_attribution.js",
    "test:server:js": "node scripts/node24.js node_modules/vitest/vitest.mjs run --config server/vitest.config.js"
  },
  "dependencies": {
    "@delebash/llm-runner": "file:../just-llm-runner/server",
    "@quasar/extras": "^2.1.0",
    "quasar": "^2.35.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@floating-ui/dom": "^1.7.6",
    "@playwright/test": "^1.61.0",
    "@quasar/app-vite": "^3.10.2",
    "@tanstack/vue-table": "^8.21.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vueuse/core": "^14.3.0",
    "autoprefixer": "^10.4.27",
    "jsdom": "^30.0.1",
    "marked": "^18.0.5",
    "pinia": "^3.0.4",
    "playwright": "^1.61.0",
    "postcss": "^8.5.8",
    "qrcode": "^1.5.4",
    "reka-ui": "^2.10.0",
    "vitest": "^4.1.10",
    "vue": "^3.5.38",
    "vue-i18n": "^11.4.6",
    "vue-router": "^5.1.0",
    "vue-sonner": "^2.0.9"
  },
  "allowScripts": {
    "electron": true,
    "koffi": true,
    "better-sqlite3": true,
    "esbuild": true,
    "@parcel/watcher": true
  }
}
