{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JustTTS",
  "version": "0.1.0",
  "identifier": "dev.justtts.app",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "JustTTS",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "AudioVideo",
    "shortDescription": "TTS server for audiobook production",
    "longDescription": "JustTTS — an open-source TTS server built for audiobook production and useful for any TTS workload. Renders chapters through any combination of Kokoro, Qwen3-TTS, Chatterbox, and other engines with ACX-compliant mastering."
  }
}
