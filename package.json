{
  "name": "justvoice",
  "version": "0.1.0",
  "description": "An open-source TTS server built for audiobook production, useful for any TTS workload.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:vite": "vite",
    "build:vite": "vite build",
    "update-pydeps": "cd server && pip install -e .",
    "preview:vite": "vite preview",
    "dev": "tauri dev",
    "build": "tauri build",
    "tauri": "tauri",
    "server": "cd server && node ../scripts/py.js -m justvoice.serve serve",
    "lint": "biome check .",
    "screenshots": "node scripts/smoke_gui.js",
    "test:unit": "vitest run",
    "test:server": "cd server && node ../scripts/py.js -m pytest -q",
    "test": "node scripts/e2e.js",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "@tanstack/vue-table": "^8.21.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@vueuse/core": "^14.3.0",
    "marked": "^18.0.5",
    "pinia": "^3.0.4",
    "reka-ui": "^2.10.0",
    "vue": "^3.5.38",
    "vue-i18n": "^11.4.6",
    "vue-router": "^5.1.0",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@playwright/test": "^1.61.0",
    "@tauri-apps/cli": "^2.11.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "jsdom": "^30.0.1",
    "playwright": "^1.61.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  }
}
